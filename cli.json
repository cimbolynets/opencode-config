{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "single": false
  },
  "prompt": {
    "paste": "full",
    "image_preview": true
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show",
    "permissions": "autoaccept",
    "verbosity": "high"
  },
  "animations": true,
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.6,
    "sound_pack": "opencode.default"
  },
  "terminal": {
    "copy": "select",
    "title": true
  },
  "tabs": {
    "layout": "horizontal",
    "scope": "cwd",
    "mode": "off",
    "indicators": "status"
  }
}
